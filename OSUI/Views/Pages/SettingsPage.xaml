<UserControl x:Class="OSUI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSUI.Views.Pages"
             xmlns:viewModels="clr-namespace:OSUI.ViewModels"
             xmlns:extensions="clr-namespace:OSUI.Extensions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}"
             DataContext="{extensions:DI {x:Type viewModels:SettingsViewModel}}"
             d:DesignHeight="300" d:DesignWidth="800">
    <Grid Margin="20">
            <StackPanel>
                <!-- <TextBlock FontSize="24" Text="Settings Page"></TextBlock> -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                     <TextBlock Grid.Row="0" Grid.Column="0" 
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                TextAlignment="Left"
                                Text="{DynamicResource Settings.ThemeSelection}" />
                     <ComboBox Grid.Row="0" Grid.Column="1"
                         Width="150"
                         HorizontalAlignment="Right"
                        ItemsSource="{Binding ThemeNames}"
                        SelectedItem="{Binding SelectedTheme}"></ComboBox>
                        
                     <TextBlock Grid.Row="1" Grid.Column="0" 
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                TextAlignment="Left"
                                Text="{DynamicResource Settings.FontSelection}" />
                     <ComboBox Grid.Row="1" Grid.Column="1"
                         Width="150"
                         Margin="0,10,0,0"
                         HorizontalAlignment="Right"
                         ItemsSource="{Binding FontNames}"
                         SelectedItem="{Binding SelectedFont}"></ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="Left"
                               Text="{DynamicResource Settings.LanguageSelection}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              Width="150"
                              Margin="0,10,0,0"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding LanguageOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedLanguageCode}" />
                </Grid>

                <Button HorizontalAlignment="Right"
                        Width="150"
                        Content="{DynamicResource Settings.Button.ChangePassword}"
                        Command="{Binding OpenChangePasswordWindowCommand}"
                        Margin="0,10,0,0"></Button>

                <Button HorizontalAlignment="Right"
                        Width="150"
                        Content="{DynamicResource Settings.Button.About}"
                        Command="{Binding ShowAboutWindowCommand}"
                        Margin="0,6"></Button>
            </StackPanel>
    </Grid>
</UserControl>
