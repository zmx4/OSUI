<UserControl x:Class="OSUI.Views.Pages.BankerAlgorithmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSUI.Views.Pages"
             xmlns:vm="clr-namespace:OSUI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BankerAlgorithmPageViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Banker.Label.ProcessCount}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBox Width="80"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         Text="{Binding ProcessCountInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{DynamicResource Banker.Label.ResourceTypeCount}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBox Width="80"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         Text="{Binding ResourceTypeCountInput, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="{DynamicResource Banker.Button.Apply}"
                        Command="{Binding ApplySizeCommand}" />
                <Button Content="{DynamicResource Banker.Button.Demo}"
                        Margin="8,0,0,0"
                        Command="{Binding UseDemoDataCommand}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Banker.Table.Available}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <Grid x:Name="AvailableResourceGrid"
                      Grid.Row="1"
                      MinHeight="70">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </Grid>
        </Grid>

        <DataGrid Grid.Row="1"
                  x:Name="ProcessGrid"
                  Margin="10,0,10,10"
                  ItemsSource="{Binding Processes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
