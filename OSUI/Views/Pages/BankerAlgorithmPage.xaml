<UserControl x:Class="OSUI.Views.Pages.BankerAlgorithmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSUI.Views.Pages"
             xmlns:vm="clr-namespace:OSUI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BankerAlgorithmPageViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Banker.Label.ProcessCount}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBox Width="80"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         Text="{Binding ProcessCountInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{DynamicResource Banker.Label.ResourceTypeCount}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBox Width="80"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         Text="{Binding ResourceTypeCountInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{DynamicResource Banker.Table.Available}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox MinHeight="40"
                         Width="80"
                         HorizontalScrollBarVisibility="Auto"
                         Margin="0,0,8,0"
                         Text="{Binding AvailableResourcesInput, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="16,0,0,0"
                  HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" 
                        Content="{DynamicResource Banker.Button.Demo}"
                        Margin="0,0,5,0"
                        Command="{Binding UseDemoDataCommand}" />
                <Button Grid.Column="1" 
                        Margin="0,0,5,0"
                        Content="{DynamicResource Banker.Button.Apply}"
                        Command="{Binding ApplySizeCommand}" />
            </Grid>
        </Grid>

        <DataGrid Grid.Row="1"
                  x:Name="ProcessGrid"
                  Margin="10,0,10,10"
                  ItemsSource="{Binding Processes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Banker.Table.ProcessId}"
                                    Binding="{Binding Id}"
                                    IsReadOnly="True"
                                    Width="Auto" />
                <DataGridTextColumn Header="{DynamicResource Banker.Table.Allocation}"
                                    Binding="{Binding Allocation}"
                                    IsReadOnly="True"
                                    Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Banker.Table.Max}"
                                    Binding="{Binding Max}"
                                    IsReadOnly="True"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"  Margin="0,10,0,0" Padding="10" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Banker.Label.RequestProcessId}" VerticalAlignment="Center"
                           Margin="0,0,8,0" FontWeight="SemiBold" />
                <TextBox Width="50" VerticalAlignment="Center" Margin="0,0,16,0"
                         Text="{Binding RequestProcessIdInput, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{DynamicResource Banker.Label.RequestVector}" VerticalAlignment="Center"
                           Margin="0,0,8,0" FontWeight="SemiBold" />
                <TextBox Width="120" VerticalAlignment="Center" Margin="0,0,16,0"
                         Text="{Binding RequestVectorInput, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="{DynamicResource Banker.Button.SimulateRequest}"
                        Margin="0,0,16,0"
                        Command="{Binding SimulateRequestCommand}" />

                <Button Content="{DynamicResource Banker.Button.CheckSafety}"
                        Command="{Binding CheckSafetyCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>