<UserControl x:Class="OSUI.Views.Pages.PageReplacementAlgorithmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSUI.Views.Pages"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:OSUI.ViewModels"
             xmlns:extensions="clr-namespace:OSUI.Extensions"
             DataContext="{extensions:DI {x:Type vm:PageReplacementAlgorithmPageViewModel}}"
             d:DataContext="{d:DesignInstance vm:PageReplacementAlgorithmPageViewModel}"
             d:DesignHeight="400" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 输入区 -->
            <RowDefinition Height="Auto" /> <!-- 控制区 -->
            <RowDefinition Height="*" />    <!-- 可视化区 -->
            <RowDefinition Height="Auto" /> <!-- 统计区 -->
        </Grid.RowDefinitions>

        <!-- 1. 输入区域 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource PageReplacement.Label.PageSequence}"
                       VerticalAlignment="Center" FontWeight="Bold" />
            <TextBox Width="300" Margin="5,0" Padding="5"
                     Text="{Binding PageSequenceInput, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource PageReplacement.Label.FrameCount}"
                       VerticalAlignment="Center" FontWeight="Bold" Margin="15,0,0,0" />
            <TextBox Width="50" Margin="5,0" Padding="5"
                     Text="{Binding FrameCountInput, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Width="100" Margin="15,0"
                      ItemsSource="{Binding AvailableAlgorithms}"
                      SelectedItem="{Binding SelectedAlgorithm}" />

            <Button Content="{DynamicResource PageReplacement.Button.Start}"
                    Command="{Binding StartDemoCommand}"
                    Padding="15,5" Cursor="Hand"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

        <!-- 2. 播放控制 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="{DynamicResource PageReplacement.Button.PrevStep}"
                    Command="{Binding PreviousStepCommand}"
                    Margin="0,0,5,0" Padding="10,3" />
            <Button Content="{DynamicResource PageReplacement.Button.NextStep}"
                    Command="{Binding NextStepCommand}"
                    Margin="0,0,5,0" Padding="10,3" />
            <Button Content="{Binding AutoPlayButtonText}"
                    Command="{Binding ToggleAutoPlayCommand}"
                    Padding="10,3" />
            <TextBlock Text="{Binding StatusText}" Margin="20,0"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource StatusForeground}" />
        </StackPanel>

        <!-- 3. 核心可视化区域 -->
        <Border Grid.Row="2" CornerRadius="8" Padding="20"
                BorderBrush="{DynamicResource VisualizationBorderBrush}"
                BorderThickness="1">
            <ScrollViewer x:Name="ScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="IcSteps" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="8" CornerRadius="6" MinWidth="70"
                                    BorderThickness="2">
                                <!-- 背景 & 边框通过 Style.Triggers 响应命中/缺页/当前步骤 -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource StepFaultBackground}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource StepBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StepHitBackground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource StepCurrentBorder}" />
                                                <Setter Property="BorderThickness" Value="2.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center">
                                    <!-- 步骤标签 T1, T2 ... -->
                                    <TextBlock Text="{Binding StepLabel}"
                                               FontSize="10"
                                               Foreground="{DynamicResource StepLabelForeground}"
                                               HorizontalAlignment="Center" />

                                    <!-- 页码 -->
                                    <TextBlock Text="{Binding PageNum}"
                                               FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource StepFaultForeground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StepHitForeground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 内存块显示 -->
                                    <ItemsControl ItemsSource="{Binding Frames}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource FrameBackground}"
                                                        CornerRadius="3" Margin="0,2"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 备注 -->
                                    <TextBlock Text="{Binding Note}" FontSize="9"
                                               Foreground="{DynamicResource NoteForeground}"
                                               TextWrapping="Wrap" MaxWidth="80" Margin="0,5,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 4. 统计信息 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatsText}" FontSize="14"
                       Foreground="{DynamicResource StatusForeground}" />
        </StackPanel>
    </Grid>
</UserControl>
