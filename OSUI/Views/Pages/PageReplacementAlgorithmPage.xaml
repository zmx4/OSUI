<UserControl x:Class="OSUI.Views.Pages.PageReplacementAlgorithmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSUI.Views.Pages"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:OSUI.ViewModels"
             xmlns:extensions="clr-namespace:OSUI.Extensions"
             xmlns:res="clr-namespace:System;assembly=mscorlib"
             DataContext="{extensions:DI {x:Type vm:PageReplacementAlgorithmPageViewModel}}"
             d:DataContext="{d:DesignInstance vm:PageReplacementAlgorithmPageViewModel}"
             d:DesignHeight="300" d:DesignWidth="800">
    <!-- <UserControl.Resources> -->
    <!--     <ResourceDictionary> -->
    <!--         <ResourceDictionary.MergedDictionaries> -->
    <!--             <ResourceDictionary Source="/Resources/Localization/Strings.zh-CN.xaml" /> -->
    <!--             <ResourceDictionary Source="/Resources/Localization/Strings.en-US.xaml" /> -->
    <!--         </ResourceDictionary.MergedDictionaries> -->
    <!--     </ResourceDictionary> -->
    <!-- </UserControl.Resources> -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 输入区 -->
            <RowDefinition Height="Auto" /> <!-- 控制区 -->
            <RowDefinition Height="*" />    <!-- 可视化区 -->
            <RowDefinition Height="Auto" /> <!-- 统计区 -->
        </Grid.RowDefinitions>

        <!-- 1. 输入区域 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource PageReplacement.Label.PageSequence}" VerticalAlignment="Center" FontWeight="Bold" />
            <TextBox x:Name="TxtPages" Width="300" Margin="5,0" Padding="5"
                     Text="7,0,1,2,0,3,0,4,2,3,0,3,2,1,2,0,1,7,0,1" />

            <TextBlock Text="{DynamicResource PageReplacement.Label.FrameCount}" VerticalAlignment="Center" FontWeight="Bold" Margin="15,0,0,0" />
            <TextBox x:Name="TxtFrames" Width="50" Margin="5,0" Padding="5" Text="3" />

            <ComboBox x:Name="CmbAlgorithm" Width="100" Margin="15,0" SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource PageReplacement.Algorithm.FIFO}" />
                <ComboBoxItem Content="{DynamicResource PageReplacement.Algorithm.LRU}" />
                <ComboBoxItem Content="{DynamicResource PageReplacement.Algorithm.OPT}" />
            </ComboBox>

            <Button Content="{DynamicResource PageReplacement.Button.Start}" Click="BtnStart_Click" Padding="15,5"
                    Background="#2196F3" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>

        <!-- 2. 播放控制 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="BtnPrev" Content="{DynamicResource PageReplacement.Button.PrevStep}" Click="BtnPrev_Click" Margin="0,0,5,0" Padding="10,3" />
            <Button x:Name="BtnNext" Content="{DynamicResource PageReplacement.Button.NextStep}" Click="BtnNext_Click" Margin="0,0,5,0" Padding="10,3" />
            <Button x:Name="BtnAutoPlay" Content="{DynamicResource PageReplacement.Button.AutoPlay}" Click="BtnAutoPlay_Click" Padding="10,3" />
            <TextBlock x:Name="TxtStatus" Margin="20,0" VerticalAlignment="Center" FontSize="14" Foreground="#333" />
        </StackPanel>

        <!-- 3. 核心可视化区域 -->
        <Border Grid.Row="2" CornerRadius="8" Padding="20"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="IcSteps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="8" CornerRadius="6" MinWidth="70"
                                    Background="{Binding BgColor}" 
                                    BorderBrush="#ccc" 
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StepLabel}" 
                                               FontSize="10" Foreground="#666"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PageNum}" 
                                               FontSize="20" 
                                               FontWeight="Bold"
                                               Foreground="{Binding FgColor}" 
                                               HorizontalAlignment="Center" Margin="0,5" />

                                    <!-- 内存块显示 -->
                                    <ItemsControl ItemsSource="{Binding Frames}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#e3f2fd" 
                                                        CornerRadius="3" Margin="0,2"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Note}" FontSize="9" Foreground="#888"
                                               TextWrapping="Wrap" MaxWidth="80" Margin="0,5,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 4. 统计信息 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStats" FontSize="14" Foreground="#333" />
        </StackPanel>
    </Grid>
</UserControl>