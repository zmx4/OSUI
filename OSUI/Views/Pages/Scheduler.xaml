<UserControl x:Class="OSUI.Views.Pages.Scheduler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSUI.Views.Pages"
             mc:Ignorable="d"
             xmlns:conv="clr-namespace:OSUI.Converters"
             xmlns:vm="clr-namespace:OSUI.ViewModels"
             d:DataContext="{d:DesignInstance vm:SchedulerPageViewModel}"
             d:DesignHeight="300" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:TimeInputConverter x:Key="TimeInputConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- <ColumnDefinition Width="Auto"/> -->
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                    Text="{DynamicResource Scheduler.AlgorithmSelection}" 
                    FontSize="24" FontWeight="Bold" Margin="10"/>
                <ComboBox Grid.Column="1"
                    Width="200" Margin="10" 
                    ItemsSource="{Binding Algorithms}" 
                    SelectedItem="{Binding SelectedAlgorithm}"/>
                <TextBlock Grid.Column="2"
                    Text="{DynamicResource Scheduler.TimeType}"
                    FontSize="24" FontWeight="Bold" Margin="5,10,5,10"/>
                <ComboBox Grid.Column="3"
                    Width="140"
                    Margin="10"
                    ItemsSource="{Binding TimeInputModes}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Mode"
                    SelectedValue="{Binding SelectedTimeInputMode}"/>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                
                <Button Grid.Column="0" 
                        Margin="5,0,0,0" 
                        Command="{Binding LoadExampleCommand}" 
                        Content="{DynamicResource Scheduler.Button.LoadExample1}" />
                
                <Button Grid.Column="1" 
                        Margin="5,0,0,0" 
                        Command="{Binding LoadSecondExampleCommand}" 
                        Content="{DynamicResource Scheduler.Button.LoadExample2}" />

                <Button Grid.Column="2" 
                        Margin="5,0,0,0" 
                        Command="{Binding AddProcessCommand}" 
                        Content="{DynamicResource Scheduler.Button.Add}" />

                <Button Grid.Column="3" 
                        Margin="5,0,5,0" 
                        Command="{Binding RunCommand}" 
                        Content="{DynamicResource Scheduler.Button.Run}" />
            </Grid>
        </Grid>
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Processes}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Scheduler.Column.ProcessId}" Binding="{Binding Id}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="{DynamicResource Scheduler.Column.ArrivalTime}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}">
                                        <Binding Path="ArrivalTime" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox>
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}" Mode="TwoWay">
                                        <Binding Path="ArrivalTime" Mode="TwoWay" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource Scheduler.Column.BurstTime}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}">
                                        <Binding Path="BurstTime" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox>
                                <TextBox.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}" Mode="TwoWay">
                                        <Binding Path="BurstTime" Mode="TwoWay" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource Scheduler.Column.StartTime}" IsReadOnly="True" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}">
                                        <Binding Path="StartTime" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource Scheduler.Column.CompletionTime}" IsReadOnly="True" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}">
                                        <Binding Path="CompletionTime" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource Scheduler.Column.TurnaroundTime}" IsReadOnly="True" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TimeInputConverter}">
                                        <Binding Path="TurnaroundTime" />
                                        <Binding Path="DataContext.SelectedTimeInputMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Scheduler.Column.WeightedTurnaroundTime}" Binding="{Binding WeightedTurnaroundTime, StringFormat={}{0:F2}}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部统计面板 -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="5">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Scheduler.Label.TotalTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding TotalTurnaroundTime}" Margin="0,0,20,0" />

                <TextBlock Text="{DynamicResource Scheduler.Label.TotalWeightedTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding TotalWeightedTurnaroundTime}" Margin="0,0,20,0" />

                <TextBlock Text="{DynamicResource Scheduler.Label.AverageTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding AverageTurnaroundTime}" Margin="0,0,20,0" />

                <TextBlock Text="{DynamicResource Scheduler.Label.AverageWeightedTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding AverageWeightedTurnaroundTime}" />
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="5">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Scheduler.Label.TotalTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding TotalTurnaroundTime}" Margin="0,0,20,0" />

                <TextBlock Text="{DynamicResource Scheduler.Label.TotalWeightedTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding TotalWeightedTurnaroundTime}" Margin="0,0,20,0" />

                <TextBlock Text="{DynamicResource Scheduler.Label.AverageTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding AverageTurnaroundTime}" Margin="0,0,20,0" />

                <TextBlock Text="{DynamicResource Scheduler.Label.AverageWeightedTurnaroundTime}" FontWeight="SemiBold" Margin="0,0,5,0" />
                <TextBlock Text="{Binding AverageWeightedTurnaroundTime}" />
            </WrapPanel>
        </Border>

    </Grid>
</UserControl>
