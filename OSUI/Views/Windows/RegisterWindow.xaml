<Window x:Class="OSUI.Views.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OSUI.Views.Windows"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:OSUI.ViewModels"
        Title="Register System" 
        Width="450" 
        Height="550"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:RegisterViewModel />
    </Window.DataContext>

    <Grid>
        <Border Padding="40,32" VerticalAlignment="Center">
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="用户注册"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,0,0,28"
                           HorizontalAlignment="Center"
                           Text="OSUI"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- 用户名 -->
                <TextBlock Margin="0,0,0,6" Text="用户名" FontWeight="Medium" />
                <TextBox Margin="0,0,0,14"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 密码 -->
                <TextBlock Margin="0,0,0,6" Text="密码" FontWeight="Medium" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" PasswordChanged="PasswordBox_PasswordChanged" />

                <!-- 确认密码 -->
                <TextBlock Margin="0,0,0,6" Text="确认密码" FontWeight="Medium" />
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,8" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                <!-- 错误提示 -->
                <TextBlock Margin="0,0,0,8"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 注册按钮 -->
                <Button Margin="0,8,0,0"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        Content="注 册"
                        IsDefault="True"
                        Command="{Binding RegisterCommand}" />

                <!-- 分隔线 -->
                <Grid Margin="0,16,0,12">
                    <Separator />
                    <TextBlock Text="或"
                               HorizontalAlignment="Center"
                               Padding="8,0"
                               Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </Grid>

                <!-- 取消按钮 -->
                <Button Padding="0,8"
                        HorizontalAlignment="Stretch"
                        Content="返回登录"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
