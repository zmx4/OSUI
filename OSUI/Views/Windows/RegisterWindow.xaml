<Window x:Class="OSUI.Views.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OSUI.Views.Windows"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:OSUI.ViewModels"
        xmlns:ext="clr-namespace:OSUI.Extensions"
        Title="{DynamicResource Register.WindowTitle}" 
        Width="450" 
        Height="550"
        WindowStartupLocation="CenterScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        DataContext="{ext:DI {x:Type vm:RegisterViewModel}}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    

    <Grid>
        <Border Padding="40,32" VerticalAlignment="Center">
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource Register.Header}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,0,0,28"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource Common.AppName}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />

                <!-- 用户名 -->
                <TextBlock Margin="0,0,0,6" Text="{DynamicResource Register.Username}" FontWeight="Medium" />
                <TextBox Margin="0,0,0,14"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 密码 -->
                <TextBlock Margin="0,0,0,6" Text="{DynamicResource Register.Password}" FontWeight="Medium" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" PasswordChanged="PasswordBox_PasswordChanged" />

                <!-- 确认密码 -->
                <TextBlock Margin="0,0,0,6" Text="{DynamicResource Register.ConfirmPassword}" FontWeight="Medium" />
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,8" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                <!-- 错误提示 -->
                <TextBlock Margin="0,0,0,8"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 注册按钮 -->
                <Button Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource Register.Button.Register}"
                        IsDefault="True"
                        Command="{Binding RegisterCommand}" />

                <!-- 分隔线 -->
                <Grid Margin="0,16,0,12">
                    <Separator />
                    <TextBlock Text="{DynamicResource Common.Or}"
                               HorizontalAlignment="Center"
                               Padding="8,0"
                               Background="{DynamicResource MaterialDesignPaper}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="12" />
                </Grid>

                <!-- 取消按钮 -->
                <Button HorizontalAlignment="Stretch"
                        Content="{DynamicResource Register.Button.BackToLogin}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
