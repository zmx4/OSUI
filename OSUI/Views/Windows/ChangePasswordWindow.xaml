<Window x:Class="OSUI.Views.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:OSUI.ViewModels"
        xmlns:ext="clr-namespace:OSUI.Extensions"
        mc:Ignorable="d"
        Title="{DynamicResource ChangePassword.WindowTitle}"
        Width="450"
        Height="450"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance vm:ChangePasswordViewModel}"
        DataContext="{ext:DI {x:Type vm:ChangePasswordViewModel}}">

    <Grid>
        <Border Padding="40,32" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource ChangePassword.Header}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,0,0,28"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource Common.AppName}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Margin="0,0,0,6" Text="{DynamicResource ChangePassword.CurrentPassword}" FontWeight="Medium" />
                <PasswordBox x:Name="CurrentPasswordBox"
                             Margin="0,0,0,14"
                             PasswordChanged="CurrentPasswordBox_PasswordChanged" />

                <TextBlock Margin="0,0,0,6" Text="{DynamicResource ChangePassword.NewPassword}" FontWeight="Medium" />
                <PasswordBox x:Name="NewPasswordBox"
                             Margin="0,0,0,14"
                             PasswordChanged="NewPasswordBox_PasswordChanged" />

                <TextBlock Margin="0,0,0,6" Text="{DynamicResource ChangePassword.ConfirmNewPassword}" FontWeight="Medium" />
                <PasswordBox x:Name="ConfirmNewPasswordBox"
                             Margin="0,0,0,8"
                             PasswordChanged="ConfirmNewPasswordBox_PasswordChanged" />

                <TextBlock Margin="0,0,0,8"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource ChangePassword.Button.Change}"
                        IsDefault="True"
                        Command="{Binding ChangePasswordCommand}" />

                <Button Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource ChangePassword.Button.Cancel}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
