<Window x:Class="OSUI.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OSUI.Views.Windows"
        xmlns:vm="clr-namespace:OSUI.ViewModels"
        xmlns:ext="clr-namespace:OSUI.Extensions"
        mc:Ignorable="d"
        Title="{DynamicResource Login.WindowTitle}" 
        Width="450" 
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        DataContext="{ext:DI {x:Type vm:LoginViewModel}}">
    

    <Grid>
    <Border Padding="40,32" VerticalAlignment="Center">
        <StackPanel>
            <!-- 标题 -->
            <TextBlock Margin="0,0,0,4"
                       HorizontalAlignment="Center"
                       Text="{DynamicResource Login.Welcome}"/>
            <TextBlock Margin="0,0,0,28"
                       HorizontalAlignment="Center"
                       Text="{DynamicResource Common.AppName}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- 用户名 -->
            <TextBlock Margin="0,0,0,6" Text="{DynamicResource Login.Username}" FontWeight="Medium" />
            <TextBox Margin="0,0,0,14"
                     InputMethod.IsInputMethodEnabled="False"
                     ToolTip="{DynamicResource Login.TestAccountTooltip}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 密码 -->
            <TextBlock Margin="0,0,0,6" Text="{DynamicResource Login.Password}" FontWeight="Medium" />
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" PasswordChanged="PasswordBox_PasswordChanged" />

            <!-- 错误提示 -->
            <TextBlock Margin="0,0,0,8"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 登录按钮 -->
            <Button Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Login.Button.Login}"
                    IsDefault="True"
                    Command="{Binding LoginCommand}"/>

            <!-- 分隔线 -->
            <Grid Margin="0,16,0,12">
                <Separator />
                <TextBlock Text="{DynamicResource Common.Or}"
                           HorizontalAlignment="Center"
                           Padding="8,0"
                           Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
            </Grid>

            <!-- 访客模式按钮 -->
            <Button Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Login.Button.Guest}"
                    Command="{Binding EnterAsGuestCommand}"
                    ToolTip="{DynamicResource Login.GuestTooltip}" />

            <!-- 注册新号按钮 -->
            <Button HorizontalAlignment="Stretch"
                    Content="{DynamicResource Login.Button.Register}"
                    Command="{Binding GoToRegisterCommand}" />
        </StackPanel>
    </Border>
</Grid>
</Window>
